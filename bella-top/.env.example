# OPENAI_API_KEY: Secret key for OpenAI API (used server-side for OP vision & text parsing)
OPENAI_API_KEY=

# OPENAI_MODEL: Configurable OpenAI model for OP interpretation (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY: Optional Gemini AI key for fallback
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GOOGLE CLOUD SERVICE ACCOUNT (JSON string or Base64 string for firebase-admin and googleapis)
GOOGLE_SERVICE_ACCOUNT_KEY=

# GOOGLE DRIVE ROOT FOLDER (Pasta "Bella Top - Produção")
DRIVE_ROOT_FOLDER_ID=1270ungaiRH5F_ZjmKFcNCJRHDFbVTosC
GOOGLE_DRIVE_ROOT_FOLDER_ID=1270ungaiRH5F_ZjmKFcNCJRHDFbVTosC

# GOOGLE DRIVE BRIDGE (Apps Script Bridge para upload e gerenciamento exclusivo pelo backend)
DRIVE_BRIDGE_URL=
DRIVE_BRIDGE_TOKEN=

# FIRESTORE / FIREBASE CONFIGURATION (Optional overrides)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=

